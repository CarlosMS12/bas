{
	"inputs": [
		{
			"type": "promptString",
			"id": "db_path",
			"description": "SQLite Database Path",
			"default": "${workspaceFolder}/estudiantes.db"
		}
	],
	"servers": {
		"sqlite-tool": {
			"command": "${workspaceFolder}/venv/bin/python",
			"args": ["-m", "mcp_sqlite_tool", "--db-path", "${input:db_path}"]
		}
	}
}
